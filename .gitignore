# === Godot Engine ============================================================
# Импорт кеш и метаданные — генерируются автоматически
.godot/
.import/
.qwen/

# Экспортированные билды
export/
builds/
*.exe
*.zip
*.dmg
*.app
*.x86_64
*.apk
*.aab
*.pck

# Редактор
*~
*.import

# === ОС файлы ================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
desktop.ini
ehthumbs.db

# Linux
*~
.fuse_hidden*
.Trash-*

# === IDE и редакторы =========================================================
# VS Code
.vscode/
*.code-workspace

# JetBrains
.idea/

# Vim
*.swp
*.swo

# === Документация и прочее ===================================================
# Временные файлы
*.tmp
*.temp

# Логи (если будут создаваться)
*.log

# Python (если есть скрипты генерации)
__pycache__/
*.pyc

# Save файлы (локальные сохранения игрока)
# user:// сохраняется отдельно, но если появятся в проекте:
*.save.json
